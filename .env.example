# ACVE-Hallucination Detector Configuration (.env.example)
# Never commit real API keys to version control.

# LLM Provider: "local_mock" (default offline mode), "openai", or "ollama"
ACVE_LLM_PROVIDER=local_mock

# OpenAI-Compatible API Configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Local Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Embedding, Reranker, and NLI Models
ACVE_EMBEDDING_BACKEND=auto
ACVE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ACVE_EMBEDDING_DIM=384
ACVE_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ACVE_NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli

# Ingestion & Chunking Parameters
ACVE_CHUNK_SIZE=256
ACVE_CHUNK_OVERLAP=40
ACVE_MAX_FILE_SIZE_MB=25
LOG_LEVEL=INFO
